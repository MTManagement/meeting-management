// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 로그인 계정 (현재는 게스트/닉네임 로그인, 추후 카카오·구글 연동 예정)
model User {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  members            Member[]
  membershipRequests MembershipRequest[]
}

// 모임
model Club {
  id                 String              @id @default(cuid())
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  members            Member[]
  events             Event[]
  boards             Board[]
  membershipRequests MembershipRequest[]
}

// 특정 모임에 속한 회원(가입 정보). userId가 있으면 실제 로그인 계정과 연결된 것,
// 없으면 총무가 계정 없이 수동으로 등록해둔 회원.
// role: 회장/총무 등 표시용 직책(자유 텍스트)
// grade: 권한 등급 - "MAIN_ADMIN" | "ADMIN" | "MEMBER"
model Member {
  id           String        @id @default(cuid())
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  role         String
  grade        String        @default("MEMBER")
  phone        String
  createdAt    DateTime      @default(now())
  duesPayments DuesPayment[]
  attendances  Attendance[]
}

// 모임 가입 신청 (승인제). status: "PENDING" | "APPROVED" | "REJECTED"
model MembershipRequest {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
}

// periodType: "YEARLY" | "HALF" | "QUARTER" | "MONTH" | "WEEK"
// periodIndex: YEARLY=1 / HALF=1~2 / QUARTER=1~4 / MONTH=1~12 / WEEK=1~53
model DuesPayment {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year        Int
  periodType  String
  periodIndex Int
  paid        Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([memberId, year, periodType, periodIndex])
}

model Event {
  id           String       @id @default(cuid())
  clubId       String
  club         Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  location     String?
  address      String?
  fee          String?
  maxAttendees Int?
  description  String?
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
}

// status: "참석" | "불참" | "미정"
model Attendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String   @default("미정")
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
}

// type: "공지" | "자유"
model Board {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name            String
  type            String
  allowMemberPost Boolean  @default(true)
  anonymous       Boolean  @default(false)
  createdAt       DateTime @default(now())
  posts           Post[]
}

model Post {
  id         String    @id @default(cuid())
  boardId    String
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title      String
  content    String
  authorName String
  createdAt  DateTime  @default(now())
  comments   Comment[]
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content    String
  authorName String
  createdAt  DateTime @default(now())
}
