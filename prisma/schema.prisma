// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 로그인 계정 (현재는 게스트/닉네임 로그인, 추후 카카오·구글 연동 예정)
model User {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  members            Member[]
  membershipRequests MembershipRequest[]
}

// 모임
model Club {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  createdAt             DateTime               @default(now())
  members               Member[]
  events                Event[]
  boards                Board[]
  membershipRequests    MembershipRequest[]
  menuPermissions       MenuPermission[]
  adminTransferRequests AdminTransferRequest[]
  memberColumns         MemberColumn[]
}

// 특정 모임에 속한 회원(가입 정보). userId가 있으면 실제 로그인 계정과 연결된 것,
// 없으면 총무가 계정 없이 수동으로 등록해둔 회원.
// role: 회장/총무 등 표시용 직책(자유 텍스트)
// grade: 권한 등급 - "MAIN_ADMIN" | "ADMIN" | "MEMBER"
model Member {
  id           String        @id @default(cuid())
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  role         String
  grade        String        @default("MEMBER")
  phone        String
  createdAt    DateTime      @default(now())
  duesPayments DuesPayment[]
  attendances  Attendance[]

  transferRequestsSent     AdminTransferRequest[] @relation("TransferFrom")
  transferRequestsReceived AdminTransferRequest[] @relation("TransferTo")
  fieldValues              MemberFieldValue[]
  pollVotes                PollVote[]
}

// 회원 목록의 관리자 정의 자유 컬럼 (완전 자유 폼빌더 대신 "컬럼명 추가 +
// 값 입력" 수준의 축소판). order는 표시 순서(생성 순).
model MemberColumn {
  id        String             @id @default(cuid())
  clubId    String
  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  values    MemberFieldValue[]
}

model MemberFieldValue {
  id       String       @id @default(cuid())
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  columnId String
  column   MemberColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  value    String

  @@unique([memberId, columnId])
}

// 등급별 메뉴 접근 권한. MAIN_ADMIN은 항상 전체 허용이라 저장하지 않는다.
// grade: "ADMIN" | "MEMBER"
// menuType: "MEMBERS" | "DUES" | "BOARD" | "SCHEDULE"
// access: "READ_WRITE" | "READ_ONLY" | "NONE"
model MenuPermission {
  id       String @id @default(cuid())
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  grade    String
  menuType String
  access   String @default("READ_WRITE")

  @@unique([clubId, grade, menuType])
}

// 메인 관리자 위임 요청 (요청 -> 수락/거절/취소). 수락 즉시 등급이 교체되며,
// 이 테이블 자체가 위임 이력(누가 언제 누구에게 위임했는지) 기록이다.
// status: "PENDING" | "ACCEPTED" | "REJECTED" | "CANCELED"
model AdminTransferRequest {
  id           String    @id @default(cuid())
  clubId       String
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   Member    @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  toMember     Member    @relation("TransferTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
}

// 모임 가입 신청 (승인제). status: "PENDING" | "APPROVED" | "REJECTED"
model MembershipRequest {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
}

// periodType: "YEARLY" | "HALF" | "QUARTER" | "MONTH" | "WEEK"
// periodIndex: YEARLY=1 / HALF=1~2 / QUARTER=1~4 / MONTH=1~12 / WEEK=1~53
model DuesPayment {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year        Int
  periodType  String
  periodIndex Int
  paid        Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([memberId, year, periodType, periodIndex])
}

model Event {
  id           String       @id @default(cuid())
  clubId       String
  club         Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  location     String?
  address      String?
  fee          String?
  maxAttendees Int?
  description  String?
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
}

// status: "참석" | "불참" | "미정"
model Attendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String   @default("미정")
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
}

// type: "공지" | "자유"
model Board {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name            String
  type            String
  allowMemberPost Boolean  @default(true)
  anonymous       Boolean  @default(false)
  createdAt       DateTime @default(now())
  posts           Post[]
}

model Post {
  id            String       @id @default(cuid())
  boardId       String
  board         Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title         String
  content       String
  authorName    String
  isPoll        Boolean      @default(false)
  allowMultiple Boolean      @default(false)
  createdAt     DateTime     @default(now())
  comments      Comment[]
  pollOptions   PollOption[]
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content    String
  authorName String
  createdAt  DateTime @default(now())
}

// 투표 게시물의 선택지. order는 표시 순서.
model PollOption {
  id     String     @id @default(cuid())
  postId String
  post   Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  label  String
  order  Int        @default(0)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([optionId, memberId])
}
