// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           String        @id @default(cuid())
  name         String
  role         String
  phone        String
  createdAt    DateTime      @default(now())
  duesPayments DuesPayment[]
  attendances  Attendance[]
}

// periodType: "YEARLY" | "HALF" | "QUARTER" | "MONTH" | "WEEK"
// periodIndex: YEARLY=1 / HALF=1~2 / QUARTER=1~4 / MONTH=1~12 / WEEK=1~53
model DuesPayment {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year        Int
  periodType  String
  periodIndex Int
  paid        Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([memberId, year, periodType, periodIndex])
}

model Event {
  id           String       @id @default(cuid())
  title        String
  date         DateTime
  location     String?
  address      String?
  fee          String?
  maxAttendees Int?
  description  String?
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
}

// status: "참석" | "불참" | "미정"
model Attendance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String   @default("미정")
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
}

// type: "공지" | "자유"
model Board {
  id              String   @id @default(cuid())
  name            String
  type            String
  allowMemberPost Boolean  @default(true)
  anonymous       Boolean  @default(false)
  createdAt       DateTime @default(now())
  posts           Post[]
}

model Post {
  id         String    @id @default(cuid())
  boardId    String
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title      String
  content    String
  authorName String
  createdAt  DateTime  @default(now())
  comments   Comment[]
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content    String
  authorName String
  createdAt  DateTime @default(now())
}
