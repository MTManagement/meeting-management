// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 로그인 계정 (현재는 게스트/닉네임 로그인, 추후 카카오·구글 연동 예정)
model User {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

// 스케치 프로젝트 (인테리어 공간 하나 = 프로젝트 하나)
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planes Plane[]
  points Point[]
  edges  Edge[]
  groups Group[]
}

// 사용자가 만든 평면(기준 평면 XY/YZ/XZ 포함, 오프셋 평면도 이 모델로 표현).
// axis: "XY" | "YZ" | "XZ", offset: 그 축의 법선 방향 이동 거리(기준 평면은 0)
model Plane {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  axis      String
  offset    Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, axis, offset])
}

// 와이어프레임의 점. 그려진 평면과 무관하게 항상 월드 좌표(x,y,z)로 저장한다.
// 서로 다른 평면 위의 선이라도 같은 좌표의 점을 공유하면 연결된 것으로 본다.
// 면(Face)은 만들지 않는다 — 점과 선만으로 구조를 표현한다.
model Point {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  z         Float
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  edgesFrom Edge[] @relation("EdgeFrom")
  edgesTo   Edge[] @relation("EdgeTo")
}

// 점과 점을 잇는 선.
model Edge {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId    String
  from      Point    @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Point    @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// 점+선 묶음 (가구 하나, 벽 하나 등). 그룹째로 이동·회전·스케일하고,
// 그룹 단위로 IGS 파일을 저장·불러올 수 있다. transform은 그룹 원점 기준 변환값.
model Group {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  transform Json     @default("{}")
  createdAt DateTime @default(now())

  points Point[]
  edges  Edge[]
}
